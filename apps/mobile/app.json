{
  "expo": {
    "name": "HostelHub PMS",
    "slug": "hostelhub-pms",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hostelhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "android": {
      "package": "com.hostelhub.pms",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "CALL_PHONE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-camera",
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
